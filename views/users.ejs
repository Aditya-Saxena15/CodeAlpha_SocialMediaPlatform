<!DOCTYPE html>
<html>

<head>
    <title>Users</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <h1>All Users</h1>

    <a href="/post">Home</a>

    <a href="/users">Find Users</a>
    <br><br>
    
    <a href="/logout">Logout</a>

    <hr>

    <% if (users.length===0) { %>

        <p>No other users found.</p>

        <% } else { %>

            <% users.forEach(user=> { %>

                <div>

                    <h3>
                        <%= user.username %>
                    </h3>

                    <form action="/follow/<%= user._id %>" method="POST">

                        <button type="submit">
                            Follow
                        </button>

                    </form>

                </div>

                <hr>

                <% }) %>

                    <% } %>

</body>

</html>